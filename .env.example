# Copy to .env. Dev-only credentials; never reuse in prod.
ENV=dev
DATABASE_URL=postgresql://hc_app:app_dev@localhost:5433/healthcare
OWNER_DATABASE_URL=postgresql://hc_owner:owner_dev@localhost:5433/healthcare
GRAPH_DATABASE_URL=postgresql://hc_graph:graph_dev@localhost:5433/healthcare
WORKER_DATABASE_URL=postgresql://hc_worker:worker_dev@localhost:5433/healthcare
ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_KEY=
# any long random string
OTP_PEPPER=

# Gemini (extract, explain, chat); Groq is the optional fallback. Sample data only on free tiers.
# Gemini keys from separate Google accounts (separate free-tier quotas), tried in order
GOOGLE_API_KEY_1=
GOOGLE_API_KEY_2=
GOOGLE_API_KEY_3=
GROQ_API_KEY=
STORAGE_DIR=data/files

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=healthcare-app

WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
