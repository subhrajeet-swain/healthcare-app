  "narrative": {
    "northStar": "The Chemist Strip",
    "overview": "A lab report should read like the blister strip of medicine an Indian patient already keeps in a kitchen drawer: printed foil, square cuts, dashed perforations between pockets, and a printed batch panel with the facts. The system is quiet foil grey with ink type, one saturated magenta product band at the top of every screen, and condensed uppercase headings that read like pharmacy print. It refuses the rounded-card-with-status-chip health app.\n\nDensity is calm and mobile-first (a single 40rem column, designed at 390px). Body text is set large (17px) for older readers and family caregivers, every target is at least 48px, and Hindi (Devanagari) runs alongside English as a first-class second line rather than a translation afterthought. Depth comes from the hairline-and-perforation system, never from shadow or rounding.",
    "keyCharacteristics": [
      "Foil grey ground, raised foil strips, ink type; magenta only on the product band and selection.",
      "Square corners everywhere (radius 0).",
      "One container, the strip: hairline outline, sections divided by dashed perforations.",
      "Barlow Condensed uppercase for headings, buttons and labels; Noto Sans and Noto Sans Devanagari for reading text.",
      "Tabular numerals throughout.",
      "State is always a word plus a colour, never colour alone."
    ],
    "rules": [
      {
        "name": "The Word-State Rule",
        "body": "A result state is always carried by a printed word (\"Normal\", \"Problem\"), with colour as reinforcement. Colour alone never signals state.",
        "section": "colors"
      },
      {
        "name": "The One Band Rule",
        "body": "Magenta appears as the product band and nowhere else that carries meaning. It is brand, not an action colour; actions are ink.",
        "section": "colors"
      },
      {
        "name": "The Second-Line Rule",
        "body": "Hindi sits as its own line or inline span (lang=\"hi\", Noto Sans Devanagari) under or beside the English, at the same size; it is never shrunk into a caption.",
        "section": "typography"
      },
      {
        "name": "The 17px Floor Rule",
        "body": "Reading text never drops below 1.0625rem; only batch labels and meta reach 0.875rem.",
        "section": "typography"
      },
      {
        "name": "The Printed-Not-Lifted Rule",
        "body": "Nothing floats. A surface is distinguished by tone and line, never by box-shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do put every grouped piece of content in a strip and divide its sections with dashed perforations, not with gaps or new boxes.",
      "Do pair each state colour with a printed word.",
      "Do give Hindi its own line or span with lang=\"hi\" at full body size.",
      "Do keep every interactive target at least 48px tall.",
      "Do use ink for actions and reserve magenta for the band.",
      "Do keep numerals tabular."
    ],
    "donts": [
      "Don't round corners; radius is 0 everywhere.",
      "Don't use box-shadow for depth.",
      "Don't signal a result state by colour alone.",
      "Don't use magenta as a button or link colour.",
      "Don't set reading text below 17px."
    ]
  }
}